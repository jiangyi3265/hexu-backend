# 正式环境叠加在 druid 配置上；启动参数：--spring.profiles.active=druid,hexu-prod
server:
  address: 127.0.0.1
  port: 8080
spring:
  datasource:
    druid:
      master:
        url: jdbc:mysql://127.0.0.1:${HEXU_MYSQL_PORT:3306}/hexu_integration?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&forceConnectionTimeZoneToSession=true
        username: ${HEXU_MYSQL_USER:hexu_integration}
        password: ${HEXU_MYSQL_PASSWORD}
hexu:
  sandbox:
    enabled: false
  demo:
    enabled: ${HEXU_DEMO_ENABLED:false}
  sensitive-key: ${HEXU_SENSITIVE_KEY}
  wechat:
    app-id: ${HEXU_WECHAT_APP_ID:}
    app-secret: ${HEXU_WECHAT_APP_SECRET:}
  wechat-pay:
    enabled: ${HEXU_WECHAT_PAY_ENABLED:false}
    all-shops-direct: ${HEXU_WECHAT_PAY_ALL_SHOPS_DIRECT:false}
    notify-url: https://fenxiao.oksja.cn/hexu/channel/notify
    direct:
      merchant-id: ${HEXU_WECHAT_PAY_DIRECT_MERCHANT_ID:}
      merchant-serial: ${HEXU_WECHAT_PAY_DIRECT_MERCHANT_SERIAL:}
      private-key-path: ${HEXU_WECHAT_PAY_DIRECT_PRIVATE_KEY_PATH:}
      public-key-path: ${HEXU_WECHAT_PAY_DIRECT_PUBLIC_KEY_PATH:}
      public-key-id: ${HEXU_WECHAT_PAY_DIRECT_PUBLIC_KEY_ID:}
      api-v3-key: ${HEXU_WECHAT_PAY_DIRECT_API_V3_KEY:}
swagger:
  enabled: false
